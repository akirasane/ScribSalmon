<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the .NET runtime (pythonnet / WebView2) load DLLs that Windows marked "downloaded from the internet"
     (zip extracted from a browser download). Without it: "Failed to resolve Python.Runtime.Loader.Initialize". -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
